<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep this file portable across folder names (no hardcoded RewriteBase).
    # If requested resource is not a real file/folder, route to index.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
