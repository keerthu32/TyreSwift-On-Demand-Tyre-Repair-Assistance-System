<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /tyreswift-backend/

    # If the requested resource is not a real file or folder,
    # send request to index.php router.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
